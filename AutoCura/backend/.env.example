# Copy this file to `.env` and fill in real local values.
# Never commit the actual `.env` file.

# ---- App ----
APP_ENV=development
DEBUG=true

# ---- Database ----
# Default: SQLite file, no database server needed.
DATABASE_URL=sqlite:///./autocura.db
# PostgreSQL instead (run `docker compose up -d postgres` first):
# DATABASE_URL=sqlite:///./autocura.db 

# ---- Security ----
SECRET_KEY=replace-this-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Monitoring thresholds ----
CPU_THRESHOLD=85
MEMORY_THRESHOLD=85
DISK_THRESHOLD=90
LATENCY_THRESHOLD=500
ERROR_RATE_THRESHOLD=0.05

# ---- Monitoring scheduler ----
MONITORING_INTERVAL_SECONDS=5

# ---- Recovery policy ----
RECOVERY_RETRY_LIMIT=3
RECOVERY_STABILIZATION_WAIT_SECONDS=4
RECOVERY_RESPONSE_DELAY_SECONDS=8

# ---- Automated end-to-end pipeline (Phase 6) ----
AUTO_RECOVERY_ENABLED=true
AUTO_RECOVERY_COOLDOWN_SECONDS=30

# ---- Docker (controlled test environment only) ----
DOCKER_BASE_URL=unix://var/run/docker.sock
AUTOCURA_CONTAINER_PREFIX=autocura_test_

# ---- ML ----
MODEL_DIR=trained_models
ACTIVE_MODEL_NAME=failure_classifier.joblib

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
